const SHEET_HEADERS=["Timestamp","Name","Guests","Wishes"];
function getSheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error("Bind this script to the RSVP Google Sheet.");return ss.getSheetByName("RSVP")||ss.getSheetByName("Sheet1")||ss.getSheets()[0];}
function ensureHeaders_(s){const r=s.getRange(1,1,1,4).getValues()[0];if(SHEET_HEADERS.some((h,i)=>String(r[i]||"").trim()!==h))s.getRange(1,1,1,4).setValues([SHEET_HEADERS]);}
function doGet(){return ContentService.createTextOutput(JSON.stringify({ok:true,message:"Vijay & Hemalatha RSVP Web App is live"})).setMimeType(ContentService.MimeType.JSON);}
function doPost(e){try{const p=(e&&e.parameter)||{};const name=String(p.name||"").trim(),guests=String(p.guests||"").trim(),wishes=String(p.wishes||"").trim();if(!name)throw new Error("Name is required.");if(!guests)throw new Error("Guests is required.");const lock=LockService.getScriptLock();lock.waitLock(10000);try{const s=getSheet_();ensureHeaders_(s);s.appendRow([new Date(),name,guests,wishes]);SpreadsheetApp.flush();}finally{lock.releaseLock();}return ContentService.createTextOutput(JSON.stringify({ok:true,message:"RSVP saved successfully"})).setMimeType(ContentService.MimeType.JSON);}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err.message||err)})).setMimeType(ContentService.MimeType.JSON);}}
